# Copy to `.env` and fill in real values. NEVER commit real secrets.

# Application
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
# 3000 is a common frontend dev port; the API uses 3001 by default.
PORT=3001
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# Database
# Local: mongodb://localhost:27017/ecommerce?replicaSet=rs0
# Atlas: mongodb+srv://<user>:<password>@<cluster>/ecommerce
DATABASE_URL=mongodb://localhost:27017/ecommerce?replicaSet=rs0
# Demo deployments (e.g. Render free tier) can skip DATABASE_URL and run an
# embedded in-memory replica set instead. Data is NOT persistent in this mode.
USE_IN_MEMORY_DB=false

# CORS — comma-separated list of allowed origins (only enforced in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Frontend base URL used when building email links (verify / reset)
FRONTEND_URL=http://localhost:5173

# Authentication (used from Phase 2)
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Account lockout / login throttling
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Verification token lifetimes
EMAIL_VERIFICATION_TOKEN_TTL=24h
PASSWORD_RESET_TOKEN_TTL=15m

# httpOnly refresh cookie
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_SAME_SITE=lax        # lax | strict | none

# Shipping policy (integer cents). Free shipping above the threshold.
SHIPPING_FLAT_CENTS=0
FREE_SHIPPING_THRESHOLD_CENTS=0

# Payments
PAYMENT_PROVIDER=mock              # mock (offline dev/test provider)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
PAYMENT_MOCK_AUTO_APPROVE=true     # mock auto-marks payments as paid
# Production hard-blocks auto-approve unless this is explicitly set to true
# (for portfolio/demo deployments where checkout must work without a gateway).
ALLOW_MOCK_AUTO_APPROVE_IN_PRODUCTION=false
